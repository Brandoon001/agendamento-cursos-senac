# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
FLASK_DEBUG=1

# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-um-valor-aleatorio-seguro

# Banco de dados
# Caminhos SQLite relativos são criados dentro da pasta instance/.
DATABASE_URL=sqlite:///senac_cursos.db

# Tempo máximo de validade do token CSRF, em segundos.
WTF_CSRF_TIME_LIMIT=3600
